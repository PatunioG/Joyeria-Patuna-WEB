rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow read/write for categories
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Allow read/write for products
    match /products/{productId} {
      allow read, write: if true;
    }

    // Allow read/write for config/auth
    match /config/{document} {
      allow read, write: if true;
    }

    // Allow read/write for sessions
    match /sessions/{sessionId} {
      allow read, write: if true;
    }

    // Allow read/write for newsletter subscriptions
    match /newsletter/{emailId} {
      allow read, write: if true;
    }

    // Allow read/write for exclusive collections
    match /collections/{collectionId} {
      allow read, write: if true;
    }
  }
}
